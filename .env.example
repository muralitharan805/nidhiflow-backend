# Application Environment & Port Configuration
NODE_ENV=development
PORT=3000
HOST_PORT=3000

# Database Settings & Connection String
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=vectordb
DB_PASSWORD=vector_admin
DB_DATABASE=nidhiflow
DATABASE_URL="postgresql://vectordb:vector_admin@localhost:5432/nidhiflow?schema=public"

# JWT Authentication Secrets
JWT_SECRET="super_secret_jwt_key_minimum_16_chars"
JWT_EXPIRES_IN="1d"

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_GLOBAL_ENABLED=true
CACHE_DISABLED_ROUTES=/health,/api/v1/auth
