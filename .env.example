# Application Environment & Port Configuration
NODE_ENV=development
PORT=3000

# Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nidhiflow?schema=public"

# JWT Authentication Secrets
JWT_SECRET="super_secret_jwt_key_minimum_16_chars"
JWT_EXPIRES_IN="1d"

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_GLOBAL_ENABLED=true
CACHE_DISABLED_ROUTES=/health,/api/v1/auth

